# The agent sandbox image for duet-daw. Build it and run it only through
# sandbox/start.sh. Everything installed here is reachable only from inside
# the sandbox.
FROM ubuntu:24.04

# Toolchain for a JUCE 9 / Tracktion Engine build on Linux.
#   - build-essential brings GCC 13, the compiler floor (spec sea14w).
#   - clang-18 is the secondary compiler; its clang-format and clang-tidy are
#     the versions the checks in AGENTS.md run, so keep this pin and CI's
#     the same number (issue 3u1blw).
#   - The X11/freetype/fontconfig/ALSA/JACK/GL headers are exactly what JUCE
#     needs with curl, WebKit and LADSPA disabled (roadmap node psmj4y).
#     libjack-jackd2-dev supplies headers only; JUCE dlopens libjack at run
#     time, so no daemon is needed to build.
#   - xvfb gives GUI slices a virtual X server: Duet is X11-only, so this is
#     what lets a component instantiate a window headlessly. It proves that
#     the code runs, never how it looks.
RUN apt-get update && \
    apt-get install -y \
        git \
        curl \
        ca-certificates \
        build-essential \
        ripgrep \
        jq \
        cmake \
        ninja-build \
        pkg-config \
        python3 \
        clang-18 \
        clang-format-18 \
        clang-tidy-18 \
        libx11-dev \
        libxrandr-dev \
        libxinerama-dev \
        libxcursor-dev \
        libxext-dev \
        libfreetype-dev \
        libfontconfig1-dev \
        libasound2-dev \
        libjack-jackd2-dev \
        libglx-dev \
        libgl1-mesa-dev \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

# The checks in AGENTS.md invoke the unversioned names.
RUN update-alternatives --install /usr/bin/clang        clang        /usr/bin/clang-18        100 && \
    update-alternatives --install /usr/bin/clang++      clang++      /usr/bin/clang++-18      100 && \
    update-alternatives --install /usr/bin/clang-format clang-format /usr/bin/clang-format-18 100 && \
    update-alternatives --install /usr/bin/clang-tidy   clang-tidy   /usr/bin/clang-tidy-18   100

# Node 22 for the agent CLIs; Bun builds the sidecar's standalone binary
# (`bun build --compile`, prototype d8k46e).
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*
RUN npm install -g bun@1.3.14

RUN npm install -g @anthropic-ai/claude-code @openai/codex
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent

# The sandbox runs as a user without privileges: agent CLIs (Claude Code,
# Codex) refuse their full-permission flags under root. The uid 1000 also
# agrees with the host user, through the runtime's userns/user flag, so that
# /workspace stays the host user's property.
RUN userdel -r ubuntu 2>/dev/null || true; \
    useradd --create-home --uid 1000 --shell /bin/bash agent
USER agent

# Catch2 v3's test discovery writes below XDG_RUNTIME_DIR; a container has no
# session to provide one (prototype xciphe hit this). start.sh points the
# variable here, and this directory lives in the home volume, so it is
# writable and it is the agent's own.
RUN mkdir -p /home/agent/.xdg-runtime && chmod 700 /home/agent/.xdg-runtime

WORKDIR /workspace
