{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "linux-base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux (Ninja Multi-Config, Debug by default)",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_DEFAULT_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-release",
      "displayName": "Linux (Ninja Multi-Config, Release by default)",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_DEFAULT_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-sanitizer-base",
      "hidden": true,
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug",
        "CMAKE_DEFAULT_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux nightly: AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "linux-sanitizer-base",
      "binaryDir": "${sourceDir}/build/linux-asan",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux nightly: ThreadSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "linux-sanitizer-base",
      "binaryDir": "${sourceDir}/build/linux-tsan",
      "description": "UBSan's vptr check is off here, and only here: under TSan it probes addresses through sanitizer_common's IsAccessibleMemoryRange, whose internal pipe TSan's interceptor then reports as a data race. linux-asan keeps vptr on. AGENTS.md has the detail.",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=thread,undefined -fno-sanitize=vptr -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread,undefined -fno-sanitize=vptr -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread,undefined"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-debug",   "configurePreset": "linux-debug",   "configuration": "Debug" },
    { "name": "linux-release", "configurePreset": "linux-release", "configuration": "Release" },
    { "name": "linux-asan",    "configurePreset": "linux-asan",    "configuration": "Debug" },
    { "name": "linux-tsan",    "configurePreset": "linux-tsan",    "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
